{
    "openapi": "3.1.0",
    "info": {
      "title": "Earn APY API",
      "description": "API for managing portfolio strategies and tracking APY",
      "contact": {
        "name": "Concrete Backend Team"
      },
      "license": {
        "name": ""
      },
      "version": "1.0.0"
    },
    "paths": {
      "/v1/metrics": {
        "get": {
          "tags": [
            "metrics"
          ],
          "operationId": "get_metrics",
          "responses": {
            "200": {
              "description": "Metrics retrieved successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Metrics"
                  }
                }
              }
            }
          }
        }
      },
      "/v1/strategy": {
        "get": {
          "tags": [
            "strategy"
          ],
          "operationId": "get_strategy",
          "parameters": [
            {
              "name": "address",
              "in": "query",
              "description": "Strategy address",
              "required": true,
              "schema": {
                "type": "string"
              },
              "example": "0x33224A0482A2999fD5E766bE46a6665725cD6Ce1"
            },
            {
              "name": "chain_id",
              "in": "query",
              "description": "Chain Id",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "example": "80094"
            }
          ],
          "responses": {
            "200": {
              "description": "Strategy found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/StrategyTotalAssetDiff"
                  }
                }
              }
            },
            "404": {
              "description": "Strategy not found",
              "content": {
                "application/json": {
  
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
  
                }
              }
            }
          }
        }
      },
      "/v1/vault:performance": {
        "get": {
          "tags": [
            "vault"
          ],
          "operationId": "get_vault_performance",
          "parameters": [
            {
              "name": "address",
              "in": "query",
              "description": "Vault address",
              "required": true,
              "schema": {
                "type": "string"
              },
              "example": "0xB6E3C1154E07F8A3DC04A9A28648C7AA30511120"
            },
            {
              "name": "chain_id",
              "in": "query",
              "description": "Chain Id",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "example": "80094"
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Get history TVL, APY, and TotalAssets with limit days back plus latest data point. Default 30, max: 365",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "example": "30"
            }
          ],
          "responses": {
            "200": {
              "description": "Vault found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/VaultPerformanceDetailed"
                  }
                }
              }
            },
            "404": {
              "description": "Vault not found",
              "content": {
                "application/json": {
  
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
  
                }
              }
            }
          }
        }
      },
      "/v1/vault:performance/all": {
        "get": {
          "tags": [
            "vault"
          ],
          "operationId": "get_all_vault_performance",
          "responses": {
            "200": {
              "description": "Vaults found",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/VaultPerformanceOverview"
                      },
                      "propertyNames": {
                        "type": "string"
                      }
                    },
                    "propertyNames": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
  
                }
              }
            }
          }
        }
      },
      "/v1/vault:tvl/all": {
        "get": {
          "tags": [
            "vault"
          ],
          "operationId": "get_all_vaults_tvl",
          "responses": {
            "200": {
              "description": "Vaults found",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/VaultTVLOverview"
                      },
                      "propertyNames": {
                        "type": "string"
                      }
                    },
                    "propertyNames": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
  
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "ApyDetails": {
          "type": "object",
          "required": [
            "apy",
            "start_erate",
            "start_timestamp",
            "end_erate",
            "end_timestamp"
          ],
          "properties": {
            "apy": {
              "type": "string"
            },
            "end_erate": {
              "type": "string"
            },
            "end_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "start_erate": {
              "type": "string"
            },
            "start_timestamp": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "DataPoint": {
          "type": "object",
          "required": [
            "timestamp",
            "amount"
          ],
          "properties": {
            "amount": {
              "type": "string"
